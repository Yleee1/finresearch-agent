# Copy this file to .env and fill the value locally. Never commit the real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Current official low-cost text model; verify against DeepSeek docs if reused later.
DEEPSEEK_MODEL=deepseek-v4-flash
# Structured routing/extraction defaults to non-thinking mode for lower cost and latency.
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=low
